# ことのあめ's Supabase project (its accounts; the record is kept in kn_records, read and written as the learner)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# ことのあめ's address, for making an account or resetting a password (default https://polylinga.vercel.app)
NEXT_PUBLIC_KOTONOAME_URL=
# Optional: ことのあめ's Google OAuth client, once this app's addresses are among its authorized JavaScript origins
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# OpenAI: /api/hear (what a learner's attempt sounds like) and the recognizer check on generated clips
OPENAI_API_KEY=
# Optional: another transcription model for /api/hear, and the whole-service ceiling per server instance per day
HEAR_MODEL=
HEAR_PER_DAY=

# Vertex AI: Gemini text-to-speech, for scripts/generate-audio.mjs only (the same project as ことのあめ)
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_SERVICE_ACCOUNT_KEY=
