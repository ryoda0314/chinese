{
  "name": "kotonooto-promo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ことのおと のプロモーション映像（Remotion）",
  "scripts": {
    "assets": "node scripts/assets.mjs",
    "say": "node scripts/say.mjs --env ../.env.local",
    "voice": "node scripts/voice.mjs",
    "music": "node scripts/marks.mjs | python scripts/music.py public/sound",
    "studio": "remotion studio src/index.ts",
    "stills": "node scripts/stills.mjs out/stills",
    "render": "remotion render src/index.ts Promo out/kotonooto-promo.mp4",
    "card": "remotion still src/index.ts Card out/kotonooto-card.png"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.499",
    "@remotion/cli": "4.0.499",
    "@remotion/renderer": "4.0.499",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "remotion": "4.0.499"
  },
  "devDependencies": {
    "@types/react": "^19",
    "esbuild": "0.28.1",
    "typescript": "^5"
  }
}
